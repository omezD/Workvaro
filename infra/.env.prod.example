# Production settings. Copy to infra/.env (git-ignored) and replace every value.
# Point both domains' DNS A records at the VPS before the first start (Caddy needs them for HTTPS).

APP_DOMAIN=hr.example.com
AUTH_DOMAIN=auth.example.com
ACME_EMAIL=it@example.com

DB_USER=ems
# Long random values: openssl rand -base64 24
DB_PASSWORD=
KEYCLOAK_ADMIN=kc-admin
KEYCLOAK_ADMIN_PASSWORD=

# AES-256 key for bank/ID fields: openssl rand -base64 32
# Back this up together with the database backups. Losing it makes those fields unreadable.
EMS_ENCRYPTION_KEY=

EMS_ZONE_ID=Asia/Kolkata
RATE_LIMIT_PER_MINUTE=120
