# Copy to .env (git-ignored) and fill in real values for non-dev environments.
# In dev every value below has a working default, so nothing needs to be set.

# --- PostgreSQL (docker compose + services) ---
DB_USER=ems
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5434
DB_HOST_PORT=5434

# --- Keycloak ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/ems

# --- Services ---
SPRING_PROFILES_ACTIVE=dev
GATEWAY_PORT=8080
EMPLOYEE_SERVICE_PORT=8081
LEAVE_SERVICE_PORT=8082
EMPLOYEE_SERVICE_URL=http://localhost:8081
LEAVE_SERVICE_URL=http://localhost:8082
CORS_ALLOWED_ORIGINS=http://localhost:4200
RATE_LIMIT_PER_MINUTE=120
EMS_ZONE_ID=Asia/Kolkata

# AES-256 key for bank/ID fields: base64 of 32 random bytes (openssl rand -base64 32).
# Losing this key makes encrypted fields unreadable, so back it up with the DB backups.
EMS_ENCRYPTION_KEY=
