meta {
  name: Login as manager
  type: http
  seq: 3
}

post {
  url: {{keycloakUrl}}/realms/ems/protocol/openid-connect/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  client_id: ems-api-test
  grant_type: password
  username: manager
  password: {{managerPassword}}
}

assert {
  res.status: eq 200
}

script:post-response {
  bru.setVar("managerToken", res.body.access_token);
}

tests {
  test("returns an access token with the realm roles", function() {
    expect(res.body.access_token).to.be.a("string");
    const payload = JSON.parse(Buffer.from(res.body.access_token.split(".")[1], "base64").toString());
    expect(payload.realm_access.roles).to.include("MANAGER");
  });
}
