meta {
  name: Manager dashboard
  type: http
  seq: 2
}

get {
  url: {{gatewayUrl}}/api/dashboard/manager
  body: none
  auth: bearer
}

auth:bearer {
  token: {{managerToken}}
}

assert {
  res.status: eq 200
}

tests {
  test("has a team", function() {
    expect(res.body.teamSize).to.be.greaterThan(0);
  });
}
