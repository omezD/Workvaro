meta {
  name: Overlapping request is 409
  type: http
  seq: 4
}

post {
  url: {{gatewayUrl}}/api/leaves
  body: json
  auth: bearer
}

auth:bearer {
  token: {{employeeToken}}
}

body:json {
  {
    "leaveTypeId": {{ulTypeId}},
    "startDate": "{{leaveDate}}",
    "endDate": "{{leaveDate}}"
  }
}

assert {
  res.status: eq 409
}
