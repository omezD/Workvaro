meta {
  name: Balance before
  type: http
  seq: 2
}

get {
  url: {{gatewayUrl}}/api/leaves/balance/me?year={{leaveYear}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{employeeToken}}
}

assert {
  res.status: eq 200
}

script:post-response {
  const cl = res.body.find(function(b) { return b.leaveTypeCode === "CL"; });
  bru.setVar("clUsedBefore", cl.used);
  bru.setVar("clAvailableBefore", cl.available);
}

tests {
  test("casual leave has days available", function() {
    const cl = res.body.find(function(b) { return b.leaveTypeCode === "CL"; });
    expect(cl.allocated).to.equal(12);
    expect(cl.available, "Casual balance used up by earlier runs: reset the DB (see api-tests/README.md)").to.be.greaterThan(0);
  });
}
