meta {
  name: HR sees headcount stats
  type: http
  seq: 10
}

get {
  url: {{gatewayUrl}}/api/employees/stats
  body: none
  auth: bearer
}

auth:bearer {
  token: {{hrToken}}
}

assert {
  res.status: eq 200
}

tests {
  test("has totals and departments", function() {
    expect(res.body.totalCurrent).to.be.greaterThan(0);
    expect(res.body.byDepartment).to.be.an("array");
  });
}
