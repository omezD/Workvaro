meta {
  name: HR puts new employee on notice
  type: http
  seq: 18
}

patch {
  url: {{gatewayUrl}}/api/employees/{{newEmployeeId}}/status
  body: json
  auth: bearer
}

auth:bearer {
  token: {{hrToken}}
}

body:json {
  {
    "status": "ON_NOTICE",
    "reason": "API test"
  }
}

assert {
  res.status: eq 200
}

tests {
  test("status changed", function() {
    expect(res.body.status).to.equal("ON_NOTICE");
  });
}
