meta {
  name: Manager lists own team
  type: http
  seq: 11
}

get {
  url: {{gatewayUrl}}/api/employees/me/team
  body: none
  auth: bearer
}

auth:bearer {
  token: {{managerToken}}
}

assert {
  res.status: eq 200
}

tests {
  test("team contains the employee", function() {
    const ids = res.body.map(function(e) { return e.id; });
    expect(ids).to.include(bru.getVar("employeeEmployeeId"));
  });
}
